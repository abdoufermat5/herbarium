{
  "manifest_version": 3,
  "name": "Herbarium",
  "short_name": "Herbarium",
  "version": "0.3.2",
  "description": "Save AI-made pages and anything on the web into your Herbarium vault, with one click.",
  "key": "",
  "icons": { "16": "icons/dark-16.png", "32": "icons/dark-32.png", "48": "icons/dark-48.png", "128": "icons/dark-128.png" },
  "action": {
    "default_title": "Save to Herbarium",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/dark-16.png", "32": "icons/dark-32.png", "64": "icons/dark-64.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["nativeMessaging", "contextMenus", "scripting", "activeTab", "tabs", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "omnibox": { "keyword": "h" },
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this page to Herbarium"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "herbarium@herbarium.app", "strict_min_version": "115.0" }
  }
}
