# Maintainer: abdoufermat5 <https://github.com/abdoufermat5>
#
# Template: the release workflow renders the __PLACEHOLDER__ values and pushes
# the result (with a generated .SRCINFO) to the AUR as `herbarium-bin`.
# See docs/distribution.md.
pkgname=herbarium-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc="Reader for the HTML pages AI tools generate"
arch=('x86_64' 'aarch64')
url="https://github.com/abdoufermat5/herbarium"
license=('MIT')
provides=('herbarium')
conflicts=('herbarium')
options=('!strip' '!debug')
source_x86_64=("herbarium_${pkgver}_amd64.deb::https://github.com/abdoufermat5/herbarium/releases/download/v${pkgver}/__FILE_X64__")
source_aarch64=("herbarium_${pkgver}_arm64.deb::https://github.com/abdoufermat5/herbarium/releases/download/v${pkgver}/__FILE_ARM64__")
sha256sums_x86_64=('__SHA_X64__')
sha256sums_aarch64=('__SHA_ARM64__')

package() {
  # The release .deb is a plain payload; unpack it (bsdtar handles both the ar
  # container and the nested data tarball) and copy the tree under $pkgdir.
  cd "$srcdir"
  local deb
  case "$CARCH" in
    x86_64) deb="herbarium_${pkgver}_amd64.deb" ;;
    aarch64) deb="herbarium_${pkgver}_arm64.deb" ;;
    *) error "unsupported architecture: $CARCH" ;;
  esac
  bsdtar -xf "$deb"
  bsdtar -xf data.tar.*
  install -d "$pkgdir"
  cp -a usr "$pkgdir/"
}
